{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(source .env*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run_tests.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_tests.sh"
          }
        ]
      }
    ]
  }
}
